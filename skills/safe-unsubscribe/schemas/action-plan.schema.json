{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NoThanks approved action plan",
  "description": "References candidates by ID only. Never contains URLs, addresses to contact, or message content.",
  "type": "object",
  "required": ["schema_version", "created_at", "scan_sha256", "approved", "actions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "created_at": { "type": "string" },
    "scan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "approved": {
      "type": "boolean",
      "description": "Set true only when the plan matches an explicit named-list or bounded-policy execution authorization from the user."
    },
    "approved_at": { "type": ["string", "null"] },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["candidate_id", "action", "method"],
        "additionalProperties": false,
        "properties": {
          "candidate_id": { "type": "string", "pattern": "^c_[0-9a-f]{12}$" },
          "action": { "enum": ["unsubscribe", "create_rule", "block_or_report"] },
          "method": { "enum": ["rfc8058-post", "mailto", "preference-page", "none", "unsafe"] },
          "reason": { "type": "string", "maxLength": 400 }
        }
      }
    }
  }
}
