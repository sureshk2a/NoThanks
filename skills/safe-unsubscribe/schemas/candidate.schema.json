{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NoThanks scan result",
  "description": "Output of scan_mailbox.py. Contains no unsubscribe URLs or message bodies.",
  "type": "object",
  "required": ["schema_version", "generated_at", "window_days", "immutable_sha256", "candidates"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string" },
    "window_days": { "type": "integer", "minimum": 1, "maximum": 3650 },
    "immutable_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id", "sender_name", "sender_address", "sender_domain", "group_key",
          "message_count", "bulk_message_count", "first_seen", "last_seen", "engagement",
          "risk", "risk_signals", "method", "excluded_reasons", "sample_subjects",
          "category", "recommended_action", "confidence", "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "candidate_id": { "type": "string", "pattern": "^c_[0-9a-f]{12}$" },
          "sender_name": { "type": "string" },
          "sender_address": { "type": "string", "minLength": 3 },
          "sender_domain": { "type": "string" },
          "group_key": { "type": "string" },
          "message_count": { "type": "integer", "minimum": 1 },
          "bulk_message_count": { "type": "integer", "minimum": 1 },
          "first_seen": { "type": ["string", "null"] },
          "last_seen": { "type": ["string", "null"] },
          "engagement": { "enum": ["low", "medium", "high", "unknown"] },
          "risk": { "enum": ["low", "medium", "high"] },
          "risk_signals": { "type": "array", "items": { "type": "string" } },
          "method": { "enum": ["rfc8058-post", "mailto", "preference-page", "none", "unsafe"] },
          "excluded_reasons": { "type": "array", "items": { "type": "string" } },
          "sample_subjects": { "type": "array", "items": { "type": "string" } },
          "category": {
            "enum": ["promotional", "newsletter", "community", "transactional", "personal", "suspicious", "unknown"]
          },
          "recommended_action": { "enum": ["unsubscribe", "create_rule", "block_or_report", "keep"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    }
  }
}
